PORT=8000
NODE_ENV=development
MONGO_URI=

# Email provider configuration
EMAIL_PROVIDER=gmail-smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# Development-only OTP logging. Set to true only in local development to print
# generated OTPs to the server terminal for testing. Never enable in production.
ENABLE_DEV_OTP_LOGGING=false
FRONTEND_URL=http://localhost:5174

# Production frontend URL verified in this project's canonical metadata:
# https://royal-higher-life-ag25.vercel.app

# Resend (optional, kept for backward compatibility)
RESEND_API_KEY=

# Security
JWT_SECRET=
JWT_EXPIRES_IN=3d
JWT_ADMIN_EXPIRES_IN=8h

# Paystack NGN online giving (start with Sandbox/test mode)
# Replace this placeholder with a genuine Sandbox key for local/testing.
# Use sk_test_... outside production and sk_live_... only when NODE_ENV=production.
# A value being set is not proof of merchant eligibility; confirm the Paystack
# account is eligible for NGN in the Paystack dashboard before enabling giving.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_real_test_key
PAYSTACK_ACCOUNT_COUNTRY=NG

# Placeholders below are examples only and are rejected as payment credentials.
# Supply the actual signing secret from Paystack's webhook configuration.
PAYSTACK_WEBHOOK_SECRET=whsec_replace_with_your_real_webhook_secret
# Optional previous signing secret while rotating keys; example placeholder only.
PAYSTACK_WEBHOOK_SECRET_PREVIOUS=

# Register this public webhook URL in Paystack:
# https://<backend-host>/api/donations/webhook/paystack

# Primary email provider: Gmail SMTP with required STARTTLS.
EMAIL_PROVIDER=gmail-smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=royalhigherlifeoutreach@gmail.com
EMAIL_PASS=
EMAIL_FROM=Royal HigherLife Christian Ministries <royalhigherlifeoutreach@gmail.com>
EMAIL_REPLY_TO=royalhigherlifeoutreach@gmail.com
ADMIN_EMAIL=royalhigherlifeoutreach@gmail.com
MINISTRY_NOTIFICATION_EMAIL=royalhigherlifeoutreach@gmail.com

# Resend remains available only when explicitly selected.
RESEND_API_KEY=
