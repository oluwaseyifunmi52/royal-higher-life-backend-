PORT=8000
NODE_ENV=development
MONGO_URI=

# Email provider configuration
EMAIL_PROVIDER=gmail-smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# Frontend URL for verification/reset links
FRONTEND_URL=http://localhost:5174

# Google OAuth (backend only; register the callback URL in Google Cloud Console)
# Local: http://localhost:8000/api/auth/social/google/callback
# Production: https://royal-higher-life-backend.onrender.com/api/auth/social/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/social/google/callback

# Facebook Login (backend only; register the callback URL in Meta for Developers)
# Local: http://localhost:8000/api/auth/social/facebook/callback
# Production: https://royal-higher-life-backend.onrender.com/api/auth/social/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:8000/api/auth/social/facebook/callback

# Production frontend URL verified in this project's canonical metadata:
# https://royal-higher-life-ag25.vercel.app

# Resend (optional, kept for backward compatibility)
RESEND_API_KEY=

# Security
JWT_SECRET=
JWT_EXPIRES_IN=3d

# Primary email provider: Gmail SMTP with required STARTTLS.
EMAIL_PROVIDER=gmail-smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=royalhigherlifeoutreach@gmail.com
EMAIL_PASS=
EMAIL_FROM=Royal HigherLife Christian Ministries <royalhigherlifeoutreach@gmail.com>
EMAIL_REPLY_TO=royalhigherlifeoutreach@gmail.com
ADMIN_EMAIL=royalhigherlifeoutreach@gmail.com
MINISTRY_NOTIFICATION_EMAIL=royalhigherlifeoutreach@gmail.com

# Resend remains available only when explicitly selected.
RESEND_API_KEY=
